# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Personal Supernote files used for local testing (tests skip if absent)
example_files/
*.note
*.mark
# Demo files are committed
!examples/*.note
!examples/*.mark
# Test fixtures from supernote-typescript are committed
!SupernoteKit/Tests/Fixtures/**/*.note
!SupernoteKit/Tests/Fixtures/**/*.mark

# Release output
dist/

# Editors
.vscode/
.idea/
*.swp
*~

# Local environment files; sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.sample

# Generated local mobile configuration
ViewerIOS/Configuration/Local.xcconfig
__pycache__/

