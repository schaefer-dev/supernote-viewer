# Copy to .env (gitignored) and fill in. Scripts read these lines as data; .env is never executed.

# Dropbox app key (public OAuth client ID). scripts/prepare-ios.py writes it to Local.xcconfig.
DROPBOX_APP_KEY=

# App Store Connect API key for scripts/ios-release.sh (App Manager role).
# Keep the .p8 outside every repository, e.g. ~/.appstoreconnect/private_keys/AuthKey_<id>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Private App Store material (listing copy, review notes, screenshots), kept in a separate private
# repository. Used by scripts/appstore-screenshots.sh.
APPSTORE_DIR=../sumi-appstore
